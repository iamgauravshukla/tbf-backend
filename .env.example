# ── The Better Face API — environment ──
# Copy to `.env` and fill in. Nothing here is committed.

# Port the API listens on.
PORT=4000

# Comma-separated browser origins allowed to call the API (site + dashboard).
# Add your production domain before launch.
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:4322

# Canonical site URL. Validates the post-submit redirect (`_next`) and is the
# thank-you fallback. Set to your production domain in production.
SITE_URL=http://localhost:4321
THANK_YOU_PATH=/thank-you/

# Where lead records are written (JSON) when NO database is set. Default: ./data
# DATA_DIR=./data

# ── Database (optional) ──
# Set to a real postgres:// URL and ALL storage (leads, users, activity, tasks)
# uses Postgres instead of the JSON files; tables are created automatically on
# boot. On Railway, add a variable that references the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Leave it blank (or as an unresolved ${{...}} template locally) to use the JSON
# store. PGSSL forces TLS 'true'/'false'; unset = inferred from the host.
DATABASE_URL=
# PGSSL=

# Optional: forward every new lead to a webhook (Slack / Zapier / CRM). Empty = off.
WEBHOOK_URL=

# Mirror every new lead to the external CRM intake, in addition to our own store.
# Base endpoint only (no query string) — `type` and `center` are appended.
# Defaults to the values below when unset; set CRM_FORWARD_URL= (empty) to disable
# (e.g. in local dev, so test submissions don't reach the live CRM).
CRM_FORWARD_URL=https://miraculous-serenity-production-5d5a.up.railway.app/api/leads
CRM_FORWARD_TYPE=call
CRM_FORWARD_CENTER=TBF

# ── Dashboard login ──
# Signs and verifies dashboard sessions. Set a long random value in production,
# or logins drop on every restart. Generate one:  openssl rand -hex 32
JWT_SECRET=
# How long a login lasts.
TOKEN_TTL=12h
# The single admin account (move to a users table when Postgres is connected).
ADMIN_EMAIL=admin@thebetterface.com
ADMIN_PASSWORD=change-me-now

# Optional legacy read key for GET /api/leads (scripts). Dashboard uses /api/admin.
API_KEY=

# Rate limit, per IP.
RATE_WINDOW_MS=900000
RATE_MAX=20
